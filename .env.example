# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/eduyatra_db?schema=public"

# Public site URL used for absolute links and future metadata.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production secret used for application-level signing/encryption when required.
# Generate a long random value; never commit the real value.
APP_SECRET="replace-with-a-long-random-secret"
