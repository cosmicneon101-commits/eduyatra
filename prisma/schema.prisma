datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  UNPUBLISH
  LOGIN
  LOGOUT
  ACTIVATE
  DEACTIVATE
  PERMISSION_CHANGE
  STATUS_CHANGE
}

model AdminUser {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String
  passwordHash String
  role         AdminRole         @default(ADMIN)
  isActive     Boolean           @default(true)
  sessions     AdminSession[]
  permissions  AdminPermission[]
  auditLogs    AuditLog[]
  mediaAssets  MediaAsset[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  @@index([isActive, role])
}

model AdminSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  @@index([adminUserId])
  @@index([expiresAt])
}

model Permission {
  id          String            @id @default(cuid())
  key         String            @unique
  label       String
  group       String
  description String?
  assignments AdminPermission[]
}

model AdminPermission {
  id           String     @id @default(cuid())
  adminUserId  String
  permissionId String
  adminUser    AdminUser  @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  @@unique([adminUserId, permissionId])
  @@index([permissionId])
}

model AuditLog {
  id          String      @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser?  @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action      AuditAction
  resource    String
  resourceId  String?
  summary     String
  metadata    Json?
  createdAt   DateTime    @default(now())
  @@index([adminUserId, createdAt])
  @@index([resource, createdAt])
}

model Blog {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String
  content        String        @db.Text
  coverImage     String
  category       String
  author         String        @default("EduYatra Team")
  status         ContentStatus @default(DRAFT)
  featured       Boolean       @default(false)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  @@index([status, publishedAt])
  @@index([featured, publishedAt])
}

model FAQ {
  id          String   @id @default(cuid())
  question    String
  answer      String   @db.Text
  category    String
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([isPublished, sortOrder])
  @@index([category, isPublished])
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  photo       String?
  testType    String
  score       String
  reading     Int?
  listening   Int?
  writing     Int?
  speaking    Int?
  destination String?
  university  String?
  course      String?
  content     String   @db.Text
  isPublished Boolean  @default(true)
  isFeatured  Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([isPublished, isFeatured, sortOrder])
}

model ContactSubmission {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String
  service   String
  message   String     @db.Text
  source    String     @default("Website Form")
  status    LeadStatus @default(NEW)
  notes     String?    @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  @@index([status, createdAt])
  @@index([service, status])
}

model AnnouncementSubscriber {
  id         String   @id @default(cuid())
  email      String   @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([isActive, createdAt])
}

model CommunityQuestion {
  id        String            @id @default(cuid())
  name      String
  email     String
  slug      String            @unique
  title     String
  content   String            @db.Text
  status    ModerationStatus  @default(PENDING)
  answers   CommunityAnswer[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  @@index([status, createdAt])
}

model CommunityAnswer {
  id         String            @id @default(cuid())
  questionId String
  question   CommunityQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  name       String
  email      String
  content    String            @db.Text
  isStaff    Boolean           @default(false)
  status     ModerationStatus  @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  @@index([questionId, status, createdAt])
}

model Course {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  shortName   String?
  description String          @db.Text
  mode        String          @default("Online Classes")
  availability String        @default("Multiple batches available")
  features    CourseFeature[]
  packages    CoursePackage[]
  isPublished Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  @@index([isPublished, sortOrder])
}

model CoursePackage {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name        String
  price       Int
  description String
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([courseId, isPublished, sortOrder])
}

model CourseFeature {
  id        String @id @default(cuid())
  courseId  String
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int    @default(0)
  @@index([courseId, sortOrder])
}

model TestBookingService {
  id              String   @id @default(cuid())
  name            String   @unique
  slug            String   @unique
  description     String?
  whatsappMessage String
  isPublished     Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([isPublished, sortOrder])
}

model Country {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  heroImage   String?
  intro       String           @db.Text
  ctaLabel    String           @default("Talk to EduYatra")
  isPublished Boolean          @default(true)
  isFeatured  Boolean          @default(false)
  sortOrder   Int              @default(0)
  sections    CountrySection[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  @@index([isPublished, sortOrder])
}

model CountrySection {
  id          String   @id @default(cuid())
  countryId   String
  country     Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  heading     String
  content     String   @db.Text
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  @@index([countryId, isPublished, sortOrder])
}

model Page {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  heroTitle      String?
  heroSubtitle   String?
  heroImage      String?
  content        String        @db.Text
  status         ContentStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  @@index([status, updatedAt])
}

model MediaAsset {
  id           String    @id @default(cuid())
  filename     String
  url          String
  altText      String?
  mimeType     String
  sizeBytes    Int?
  uploadedById String?
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  @@index([mimeType, createdAt])
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt
}
